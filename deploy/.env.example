# Copy to /opt/spliteasy/.env on the server, chmod 600, and replace every placeholder.
PUBLIC_ORIGIN=https://split-easy.io
API_ORIGIN=https://api.split-easy.io
POSTGRES_PASSWORD=
APP_JWT_SECRET=
# Host file owned by UID 65532, mode 0400; mounted read-only in cloudflared.
TUNNEL_TOKEN_FILE=/opt/spliteasy/tunnel.token

# Optional native SMTP, disabled until an owned sender and delivery are reviewed.
# Compose uses PUBLIC_ORIGIN for account links and enforces authenticated TLS.
APP_MAIL_ENABLED=false
# Set false only when enabling/reviewing outbound authenticated TLS SMTP.
APP_MAIL_EGRESS_INTERNAL=true
APP_MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Set true only for an SMTP server requiring implicit TLS (normally port 465).
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=false
