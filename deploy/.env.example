# Copy to /opt/spliteasy/.env on the server, chmod 600, and replace every placeholder.
PUBLIC_ORIGIN=https://split-easy.io
API_ORIGIN=https://api.split-easy.io
POSTGRES_PASSWORD=
APP_JWT_SECRET=
# Host file owned by UID 65532, mode 0400; mounted read-only in cloudflared.
TUNNEL_TOKEN_FILE=/opt/spliteasy/tunnel.token
