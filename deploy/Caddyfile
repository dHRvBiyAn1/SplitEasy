{
	admin off
	auto_https off
	persist_config off
	servers {
		# Only cloudflared reaches this private listener in production.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

http://:80 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	@api path /api /api/*
	handle @api {
		header Cache-Control "no-store"
		# Preserve the prefix: Spring controllers already include /api.
		reverse_proxy backend:8080 {
			# Replace caller-supplied forwarding with the verified tunnel client.
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			header_up -Forwarded
		}
	}
	handle {
		respond 404
	}
}

# Private container health, never published in production.
http://:8081 {
	respond /health "OK" 200
}
