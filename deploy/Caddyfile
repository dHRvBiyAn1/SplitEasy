{
	admin off
	auto_https off
	persist_config off
}

http://:80 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	@api path /api /api/*
	handle @api {
		header Cache-Control "no-store"
		# Preserve the prefix: Spring controllers already include /api.
		reverse_proxy backend:8080
	}
	handle {
		respond 404
	}
}

# Private container health, never published in production.
http://:8081 {
	respond /health "OK" 200
}
