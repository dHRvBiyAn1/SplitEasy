{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	# Preserve /api: Spring controllers already include this prefix.
	@api path /api /api/*
	handle @api {
		reverse_proxy backend:8080
	}
	@management path /actuator /actuator/*
	handle @management {
		respond 404
	}
	handle {
		root * /usr/share/caddy
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Container health only; this port is never published by Compose.
http://:8081 {
	respond /health "OK" 200
}
